<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MOIT151.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:login="clr-namespace:MOIT151.Mobile.Pages.Login"
    xmlns:files="clr-namespace:MOIT151.Mobile.Pages.Files"
    Title="MOIT151.Mobile">

    <Tab>
        <ShellContent
            Title="Log In"
            ContentTemplate="{DataTemplate login:LoginView}"
            Route="LoginView"/>
    </Tab>
    
    <Tab>
        <ShellContent
            Title="MOIT151 App"
            ContentTemplate="{DataTemplate files:FilesView}"
            Route="FilesView"/>
    </Tab>

</Shell>
